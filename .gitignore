# Dependencies
node_modules/

# Build outputs
dist/
dist-ssr/
release/
# build/ klasörü icon.ico içeriyor — onu commit'liyoruz; sadece geçici
# build artefaktlarını (varsa) ignore et. icon.ico assets/icon/'a kopyalandı.

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS
.DS_Store
Thumbs.db

# Environment & secrets
*.local
.env
.env.*

# Claude Code
.claude/

# Geçici / tanılama dosyaları
project_dump_clean.txt
*.blockmap
*_verification_report.json

# Runtime — config'lerin gerçek (deviceId'li) kopyaları kullanıcıya özel.
# Sadece *.template.json git'e dahildir.
config/client-config.json
config/server-config.json
.meba-running.pid
.app-running.pid
server/db.json.lock

# Server runtime artefaktları (otomatik üretilir, kullanıcıya özel)
server/backups/
server/sync_telemetry.log

# Kullanıcı yüklediği profil fotoğrafları (kişisel veri)
public/profil-fotograflari/
sync_telemetry.log
server/sync_telemetry.log
server/email_dispatch.log

# bin/node.exe — USB hazırlığında manuel kopyalanır (87 MB, Git LFS'siz).
bin/

# Canlı veritabanı — her firma kendi db'sine sahip; kaynak kontrolüne girmez.
server/db.json

# Production build çıktısı (build:production komutu üretir)
build-deployment/
